+// Adresu lze přepsat: localStorage.setItem('radarUrl','https://...')
+const RADAR = localStorage.getItem('radarUrl') || 'http://127.0.0.1:8001';
+let radarOk = false;
+const RADAR_LEADS = {};            // ico (bez úvodních nul) -> {score, lead_level}
+const RADAR_COLORS = {HOT:'#dc2626', HIGH:'#ea580c', WATCH:'#ca8a04', LOW:'#94a3b8'};
+const radarIco = ico => String(ico||'').replace(/^0+/,'');
+const radarFor = ico => RADAR_LEADS[radarIco(ico)] || null;
+
+async function loadRadar(){
+  try{
+    const r = await fetch(`${RADAR}/api/leads?min_score=1&limit=1000`,
+                          {signal: AbortSignal.timeout(4000)});
+    if(!r.ok) return;
+    (await r.json()).forEach(l => {
+      RADAR_LEADS[radarIco(l.ico)] = {score: l.score, lead_level: l.lead_level};
+    });
+    radarOk = true;
+  }catch(e){/* Radar neběží – aplikace funguje normálně dál */}
+}
+loadRadar();
+
+function radarBadge(ico, small){
+  const l = radarFor(ico);
+  if(!l) return '';
+  const c = RADAR_COLORS[l.lead_level] || RADAR_COLORS.LOW;
+  return `<span title="RBD Radar: obchodní potenciál" style="display:inline-block;margin-left:6px;padding:${small?'1px 7px':'2px 9px'};border-radius:999px;background:${c};color:#fff;font-size:${small?'10px':'11px'};font-weight:700;vertical-align:middle">📡 ${l.score}</span>`;
+}
+
+async function fillRadarSec(ico){
+  const el = document.getElementById('radar-sec');
+  if(!el) return;
+  try{
+    const r = await fetch(`${RADAR}/api/leads/${radarIco(ico)}`,
+                          {signal: AbortSignal.timeout(4000)});
+    if(!r.ok){ el.innerHTML=''; return; }
+    const d = await r.json();
+    const c = RADAR_COLORS[d.lead_level] || RADAR_COLORS.LOW;
+    const sigs = [];
+    const seen = new Set();
+    (d.documents||[]).forEach(doc => (doc.signals||[]).forEach(s => {
+      const key = s.label + (s.value||'');
+      if(seen.has(key)) return; seen.add(key);
+      sigs.push(`<span style="display:inline-block;margin:3px 4px 0 0;padding:3px 10px;border-radius:999px;background:${s.value?'#ecfdf5':'#eef2ff'};color:${s.value?'#065f46':'#3730a3'};font-size:12px">${esc(s.label)}${s.value?': '+esc(s.value):''}</span>`);
+    }));
+    el.innerHTML = `<div class="sec"><div class="sec-t">📡 RBD Radar — obchodní potenciál</div>
+      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
+        <span style="padding:6px 14px;border-radius:9px;background:${c};color:#fff;font-weight:700">${d.score}/100 · ${d.lead_level}</span>
+        <span style="font-size:12px;color:var(--text3)">${(d.documents||[]).length} zpracovaných listin</span>
+      </div>
+      <div>${sigs.join('') || '<span style="font-size:12px;color:var(--text3)">Zatím žádné signály — listiny nebyly zpracovány.</span>'}</div></div>`;
+  }catch(e){ el.innerHTML=''; }
+}
